# ====================================================================
# SkillSync AI - Environment Configuration
# ====================================================================

# 1. Supabase Cloud Database & Authentication (Optional for demo, required for cloud persistence)
# Create a free project at https://supabase.com
# Run SQL schemas found in `supabase/migrations/` in your Supabase SQL Editor.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Python Backend & AI Configuration (Optional: fallback heuristic ML runs if not set)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 3. Backend Port & Host
PORT=8000
HOST=0.0.0.0
